{
  "name": "playwright-bdd",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + Cucumber BDD with POM. Tightened from POM-Playwright-Automation, pointed at Toolshop.",
  "scripts": {
    "test": "node src/utils/run.js",
    "test:headed": "node src/utils/run.js --headed",
    "test:smoke": "node src/utils/run.js --tags @smoke",
    "test:e2e": "node src/utils/run.js --tags @checkout",
    "report": "node src/utils/reporter.js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@playwright/test": "^1.55.0",
    "cucumber-html-reporter": "^7.2.0",
    "dotenv": "^16.4.7"
  }
}
